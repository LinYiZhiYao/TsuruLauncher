<UserControl x:Class="TsuruLauncher.Quiz.Views.PythonQuizPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 刷题模块自带一套美西螈色板，不跟启动器主题混（浅色下观感一致） -->
                <ResourceDictionary Source="/TsuruLauncher;component/Quiz/Theme/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部栏：返回 + 子页导航 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Button x:Name="BackButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource SoftButton}" Padding="14,7"
                        Content="&#x2190; 返回启动器" Click="BackClicked"/>

                <Grid x:Name="NavHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 选中指示块：整块胶囊滑过去（不是每一项自己硬切背景色） -->
                    <Border x:Name="NavIndicator" Height="32" CornerRadius="16"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="IndicatorTransform"/>
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel x:Name="NavItems" Orientation="Horizontal"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="PageHost" ClipToBounds="True"/>

        <!-- ==================== 自绘确认框 ==================== -->
        <Grid Grid.RowSpan="2" x:Name="OverlayHost" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="#66000000" Opacity="0"/>
            <Border x:Name="DialogCard" Width="420" CornerRadius="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DialogShift" Y="10"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#323264" Opacity="0.18" BlurRadius="24"
                                      ShadowDepth="6" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="DialogMessage" Style="{StaticResource Body}" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DialogNo" Style="{StaticResource SoftButton}"
                                Padding="20,8" Margin="0,0,10,0"/>
                        <Button x:Name="DialogYes" Style="{StaticResource PrimaryButton}" Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
