<UserControl x:Class="TsuruLauncher.Quiz.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 模块自带色板：挂在页面级，避免和启动器的全局资源打架 -->
                <ResourceDictionary Source="/TsuruLauncher;component/Quiz/Theme/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32">
            <TextBlock Text="统计" Style="{StaticResource H1}"/>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="已做题目" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="StatDone" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="总正确率" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="StatAcc" Text="0%" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="待复习" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="StatWrong" Text="0" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="题库题量" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="StatBank" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="各章节正确率" Style="{StaticResource H2}" Margin="0,26,0,12"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel x:Name="Bars"/>
            </Border>

            <TextBlock Text="数据" Style="{StaticResource H2}" Margin="0,26,0,12"/>
            <Border Style="{StaticResource CardStyle}" BorderBrush="{StaticResource BorderBrush}">
                <StackPanel>
                    <TextBlock x:Name="StorePathText" Style="{StaticResource Muted}"/>
                    <Button Content="清空所有答题进度" Style="{StaticResource SoftButton}"
                            Padding="16,8" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Click="ResetClicked"/>
                    <TextBlock x:Name="BackupText" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
