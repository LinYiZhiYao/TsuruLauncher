<UserControl x:Class="TsuruLauncher.Quiz.Views.ChoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 模块自带色板：挂在页面级，避免和启动器的全局资源打架 -->
                <ResourceDictionary Source="/TsuruLauncher;component/Quiz/Theme/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,16" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="章节" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CategoryBox" Width="180" Margin="10,0,0,0"
                              VerticalAlignment="Center" Style="{StaticResource SoftComboBox}"
                              SelectionChanged="CategoryChanged"/>
                    <CheckBox x:Name="ShuffleCheck" Content="乱序" Margin="20,0,0,0"
                              VerticalAlignment="Center" Style="{StaticResource SoftCheckBox}"
                              Checked="FilterChanged" Unchecked="FilterChanged"/>
                    <CheckBox x:Name="OnlyWrongCheck" Content="只看错题" Margin="16,0,0,0"
                              VerticalAlignment="Center" Style="{StaticResource SoftCheckBox}"
                              Checked="FilterChanged" Unchecked="FilterChanged"/>
                    <CheckBox x:Name="RealOnlyCheck" Content="仅真题" Margin="16,0,0,0"
                              VerticalAlignment="Center" Style="{StaticResource SoftCheckBox}"
                              ToolTip="排除个人精编题和内置示例题，只保留官方样题与真题"
                              Checked="FilterChanged" Unchecked="FilterChanged"/>
                </StackPanel>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,16">
                <Border x:Name="EmptyHint" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Style="{StaticResource Body}"/>
                </Border>

                <Border x:Name="StemCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="CategoryTag" Text="分类" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StemText" Style="{StaticResource Body}" FontSize="14" LineHeight="24"/>
                        <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" FontSize="11"
                                   Margin="0,12,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="OptionsPanel" Margin="0,14,0,0">
                    <Border x:Name="Opt0" Tag="0" Style="{StaticResource OptionCard}" MouseLeftButtonUp="OptionClicked">
                        <Grid>
                            <Border x:Name="OptHover0" Background="{StaticResource HoverBrush}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="OptState0" CornerRadius="10" Opacity="0"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Name="OptText0" Grid.Column="1" Margin="12,0,0,0"
                                           Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="Opt1" Tag="1" Style="{StaticResource OptionCard}" MouseLeftButtonUp="OptionClicked">
                        <Grid>
                            <Border x:Name="OptHover1" Background="{StaticResource HoverBrush}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="OptState1" CornerRadius="10" Opacity="0"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                    <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Name="OptText1" Grid.Column="1" Margin="12,0,0,0"
                                           Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="Opt2" Tag="2" Style="{StaticResource OptionCard}" MouseLeftButtonUp="OptionClicked">
                        <Grid>
                            <Border x:Name="OptHover2" Background="{StaticResource HoverBrush}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="OptState2" CornerRadius="10" Opacity="0"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                    <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Name="OptText2" Grid.Column="1" Margin="12,0,0,0"
                                           Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="Opt3" Tag="3" Style="{StaticResource OptionCard}" MouseLeftButtonUp="OptionClicked">
                        <Grid>
                            <Border x:Name="OptHover3" Background="{StaticResource HoverBrush}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="OptState3" CornerRadius="10" Opacity="0"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource SurfaceAltBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                    <TextBlock Text="D" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <TextBlock x:Name="OptText3" Grid.Column="1" Margin="12,0,0,0"
                                           Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border x:Name="ResultPanel" Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        Opacity="0" Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="ResultAnswer" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                        <Border Margin="0,12,0,0" Padding="14" Background="{StaticResource WhiteBrush}"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="解析" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="ExplainText" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="28,14" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="上一题" Style="{StaticResource SoftButton}"
                        HorizontalAlignment="Left" Padding="18,8" Click="PrevClicked"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重来一轮" Style="{StaticResource SoftButton}"
                            Padding="18,8" Margin="0,0,10,0" Click="RestartClicked"/>
                    <Button x:Name="NextBtn" Content="下一题" Style="{StaticResource PrimaryButton}"
                            Padding="18,8" Click="NextClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
