<UserControl x:Class="TsuruLauncher.Quiz.Views.CodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 模块自带色板：挂在页面级，避免和启动器的全局资源打架 -->
                <ResourceDictionary Source="/TsuruLauncher;component/Quiz/Theme/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,16" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="题型" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CategoryBox" Width="180" Margin="10,0,0,0"
                              VerticalAlignment="Center" Style="{StaticResource SoftComboBox}"
                              SelectionChanged="CategoryChanged"/>
                    <CheckBox x:Name="RealOnlyCheck" Content="仅真题" Margin="16,0,0,0"
                              VerticalAlignment="Center" Style="{StaticResource SoftCheckBox}"
                              ToolTip="排除个人精编题和内置示例题"
                              Checked="FilterChanged" Unchecked="FilterChanged"/>
                    <TextBlock x:Name="PythonHint" Style="{StaticResource Muted}" FontSize="11"
                               Margin="18,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,18,28,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="CategoryTag" Text="分类" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StemText" Style="{StaticResource Body}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="28,8,28,0" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="在这里写代码" Style="{StaticResource Muted}"/>
                </Border>
                <TextBox x:Name="CodeBox" Grid.Row="1" Style="{StaticResource MonoBox}"
                         BorderThickness="0" Padding="14,10" AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="Transparent"/>
                <Border Grid.Row="2" Padding="14,7" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="程序输入" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="StdinBox" Grid.Column="1" Style="{StaticResource MonoBox}"
                                 BorderThickness="0" Padding="0" Background="Transparent" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTip="题目要求从键盘读入数据时，把输入填在这里，每行一个值"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="28,14,28,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RunBtn" Content="运行" Style="{StaticResource PrimaryButton}"
                            Padding="20,8" Click="RunClicked"/>
                    <Button Content="看参考答案" Style="{StaticResource SoftButton}"
                            Padding="16,8" Margin="10,0,0,0" Click="ToggleReference"/>
                    <Button Content="标记已掌握" Style="{StaticResource SoftButton}"
                            Padding="16,8" Margin="10,0,0,0" Click="MarkMastered"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="上一题" Style="{StaticResource SoftButton}" Padding="16,8" Click="PrevClicked"/>
                    <Button Content="下一题" Style="{StaticResource SoftButton}" Padding="16,8"
                            Margin="10,0,0,0" Click="NextClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="28,14,28,20" Padding="0">
            <StackPanel>
                <Border x:Name="ReferencePanel" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="Collapsed" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock Text="参考答案" Style="{StaticResource H2}"/>
                        <TextBox x:Name="ReferenceBox" Style="{StaticResource MonoBox}" Margin="0,10,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderThickness="0" Background="Transparent" MaxHeight="260"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                        Background="{StaticResource SurfaceAltBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Padding="14,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="运行结果" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="JudgeText" Style="{StaticResource Muted}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <TextBox x:Name="OutputBox" Grid.Row="1" Style="{StaticResource MonoBox}"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Padding="14,10" MinHeight="110" MaxHeight="180"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
